<!DOCTYPE html>
<html>
<head>
  <title>Dashboard</title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
  <style>
    :root {
      --forest-green-dark: #1B3A2D;
      --forest-green: #2F4F4F;
      --forest-green-light: #4A7367;
      --forest-green-lighter: #A3B7B1;
      --red-isolation-bg: #f8d7da;  
      --red-isolation-text: #842029; 
    }

    body {
      background-color: var(--forest-green-lighter);
      color: var(--forest-green-dark);
      font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    }

    h1 {
      color: var(--forest-green-dark);
      font-weight: 700;
    }

    .isolation-room {
      background-color: var(--red-isolation-bg) !important;
      color: var(--red-isolation-text) !important;
      font-weight: 600;
    }

    .patient-names {
      font-size: 0.85rem;
      color: var(--forest-green-light);
      margin-top: 0.25rem;
      font-style: italic;
    }

    thead.table-dark {
      background-color: var(--forest-green);
      color: white;
    }

    tbody tr:nth-child(odd) {
      background-color: #e1ebe9;
    }

    tbody tr:nth-child(even) {
      background-color: #cbd9d6;
    }

    a {
      color: var(--forest-green-dark);
      text-decoration: none;
    }
    a:hover {
      color: var(--forest-green-light);
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <%- include('nav_bar', { active: 'dashboard' }) %>

  <div class="container mt-5">
    <h1 class="mb-4 text-center">Hospital Room Dashboard</h1>
    
    <table class="table table-bordered">
      <thead class="table-dark">
        <tr>
          <th>Room Number</th>
          <th>Room Type</th>
          <th>Total Capacity</th>
          <th>Occupied Beds</th>
          <th>Beds Available</th>
          <th>Patients</th>
        </tr>
      </thead>
      <tbody>
        <% rooms.forEach(room => { %>
          <tr class="<%= room.isolation ? 'isolation-room' : '' %>">
            <td><%= room.number %></td>
            <td><%= room.type %></td>
            <td><%= room.capacity %></td>
            <td><%= room.occupants.length %></td>
            <td><%= room.capacity - room.occupants.length %></td>
            <td>
              <% if (room.occupants.length > 0) { %>
                <ul class="patient-names list-unstyled mb-0">
                  <% room.occupants.forEach(patient => { %>
                    <li><%= patient.name %></li>
                  <% }) %>
                </ul>
              <% } else { %>
                <em>No patients</em>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <div class="mt-4">
      <h4>Total Patients in Hospital: 
        <%= rooms.reduce((total, room) => total + room.occupants.length, 0) %>
      </h4>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
