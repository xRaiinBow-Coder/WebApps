<!DOCTYPE html>
<html>
<head>
  <title>Dashboard</title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
  <style>
    /* Highlight isolation rooms in red */
    .isolation-room {
      background-color: #f8d7da !important; /* light red background */
      color: #842029 !important; /* dark red text */
    }
    /* Smaller text for patient names */
    .patient-names {
      font-size: 0.85rem;
      color: #6c757d; /* bootstrap secondary text */
      margin-top: 0.25rem;
    }
  </style>
</head>
<body>
  <%- include('nav_bar', { active: 'dashboard' }) %>

  <div class="container mt-5">
    <h1 class="mb-4 text-center">Hospital Room Dashboard</h1>
    
    <table class="table table-striped table-bordered">
      <thead class="table-dark">
        <tr>
          <th>Room Number</th>
          <th>Room Type</th>
          <th>Total Capacity</th>
          <th>Occupied Beds</th>
          <th>Beds Available</th>
          <th>Patients</th>
        </tr>
      </thead>
      <tbody>
        <% rooms.forEach(room => { %>
          <tr class="<%= room.isolation ? 'isolation-room' : '' %>">
            <td><%= room.number %></td>
            <td><%= room.type %></td>
            <td><%= room.capacity %></td>
            <td><%= room.occupants.length %></td>
            <td><%= room.capacity - room.occupants.length %></td>
            <td>
              <% if (room.occupants.length > 0) { %>
                <ul class="patient-names list-unstyled mb-0">
                  <% room.occupants.forEach(patient => { %>
                    <li><%= patient.name %></li>
                  <% }) %>
                </ul>
              <% } else { %>
                <em>No patients</em>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <div class="mt-4">
      <h4>Total Patients in Hospital: 
        <%= rooms.reduce((total, room) => total + room.occupants.length, 0) %>
      </h4>
    </div>
  </div>

  <!-- Bootstrap JS bundle for navbar toggle functionality -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
