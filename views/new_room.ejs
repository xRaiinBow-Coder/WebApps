<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Create New Room</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous" />
  <style>
    :root {
      --forest-green: #2F4F4F;
      --forest-green-light: #3D6B6B;
      --forest-green-dark: #223838;
    }
    body {
      background-color: #F5F6F0;
      color: var(--forest-green-dark);
      padding: 40px;
      font-family: Arial, sans-serif;
    }
    h1 {
      color: var(--forest-green-dark);
    }
    .form-container {
      max-width: 500px;
      background: white;
      padding: 30px;
      border-radius: 10px;
      box-shadow: 0 0 15px rgba(0,0,0,0.1);
      border: 1px solid var(--forest-green-light);
    }
    .btn-primary {
      background-color: var(--forest-green);
      border-color: var(--forest-green);
    }
    .btn-primary:hover {
      background-color: var(--forest-green-dark);
      border-color: var(--forest-green-dark);
    }
    .btn-link {
      color: var(--forest-green);
      text-decoration: none;
      margin-top: 15px;
      display: inline-block;
    }
    .btn-link:hover {
      text-decoration: underline;
      color: var(--forest-green-dark);
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="form-container mx-auto">
      <h1 class="mb-4">Create a New Room</h1>

      <form action="/room" method="POST" novalidate>
        <div class="mb-3">
          <label for="number" class="form-label">Room Number:</label>
          <input type="text" id="number" name="number" class="form-control" required placeholder="Enter room number" />
        </div>

        <div class="mb-3">
          <label for="type" class="form-label">Room Type:</label>
          <select id="type" name="type" class="form-select" required>
            <option value="general">General Ward</option>
            <option value="isolation">Isolation</option>
          </select>
        </div>

        <div class="mb-3">
          <label for="capacity" class="form-label">Capacity:</label>
          <input type="number" id="capacity" name="capacity" class="form-control" min="1" required placeholder="Enter capacity" />
        </div>

        <button type="submit" class="btn btn-primary w-100">Create Room</button>
      </form>

      <a href="/rooms" class="btn-link">← Back to Room List</a>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
</body>
</html>
