

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Patient Details</title>
    <!-- Bootstrap CSS CDN -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <style>
        /* Forest green theme */
        :root {
            --forest-green: #2F4F4F;
            --forest-green-light: #3D6B6B;
            --forest-green-dark: #223838;
        }
        body {
            background-color: #F5F6F0;
            color: var(--forest-green-dark);
        }
        h1 {
            color: var(--forest-green-dark);
        }
        .btn-primary {
            background-color: var(--forest-green);
            border-color: var(--forest-green);
        }
        .btn-primary:hover {
            background-color: var(--forest-green-dark);
            border-color: var(--forest-green-dark);
        }
        .btn-secondary {
            background-color: var(--forest-green-light);
            border-color: var(--forest-green-light);
        }
        .btn-secondary:hover {
            background-color: var(--forest-green);
            border-color: var(--forest-green);
        }
        .card {
            background-color: #FFFFFF;
            border-color: var(--forest-green-light);
        }
        .card-body {
            color: var(--forest-green-dark);
        }
        .card-text strong {
            color: var(--forest-green);
        }
        .btn-danger {
            background-color: #8B0000;
            border-color: #8B0000;
        }
        .btn-danger:hover {
            background-color: #6B0000;
            border-color: #6B0000;
        }
    </style>
</head>
<body>
<div class="container mt-5">
    <h1 class="mb-4">Patient Details</h1>
    <div class="card mb-4">
        <div class="card-body">
            <p class="card-text"><strong>ID:</strong> <%= patient._id %></p>
            <p class="card-text"><strong>Name:</strong> <%= patient.name %></p>
            <p class="card-text"><strong>Age:</strong> <%= patient.age %></p>
            <p class="card-text"><strong>Gender:</strong> <%= patient.gender.charAt(0).toUpperCase() + patient.gender.slice(1) %></p>
            <p class="card-text"><strong>Admission Date:</strong> <%= patient.admissionDate.toDateString() %></p>
            <p class="card-text"><strong>Allergies:</strong> 
                <% if (patient.allergies.length > 0) { %>
                    <%= patient.allergies.join(", ") %>
                <% } else { %>
                    None
                <% } %>
            </p>
            <p class="card-text"><strong>Medical Conditions:</strong> 
                <% if (patient.medicalConditions.length > 0) { %>
                    <%= patient.medicalConditions.join(", ") %>
                <% } else { %>
                    None
                <% } %>
            </p>
        </div>
    </div>

    <div class="mb-3">
        <a href="/patient/<%= patient._id %>/edit" class="btn btn-primary me-2">Edit</a>
        <form action="/patient/<%= patient._id %>?_method=DELETE" method="POST" class="d-inline">
            <button type="submit" class="btn btn-danger">Delete</button>
        </form>
    </div>

    <a href="/patients" class="btn btn-secondary">Back to List</a>
</div>

<!-- Bootstrap JS Bundle (optional) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>
