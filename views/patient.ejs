<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Patient Details</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous" />
  <style>
    :root {
      --forest-green: #2F4F4F;
      --forest-green-light: #3D6B6B;
      --forest-green-dark: #223838;
    }
    body {
      background-color: #F5F6F0;
      color: var(--forest-green-dark);
    }
    h1 {
      color: var(--forest-green-dark);
    }
    .btn-primary {
      background-color: var(--forest-green);
      border-color: var(--forest-green);
    }
    .btn-primary:hover {
      background-color: var(--forest-green-dark);
      border-color: var(--forest-green-dark);
    }
    .btn-secondary {
      background-color: var(--forest-green-light);
      border-color: var(--forest-green-light);
    }
    .btn-secondary:hover {
      background-color: var(--forest-green);
      border-color: var(--forest-green);
    }
    .card {
      background-color: #FFFFFF;
      border-color: var(--forest-green-light);
    }
    .card-body {
      color: var(--forest-green-dark);
    }
    .card-text strong {
      color: var(--forest-green);
    }
    .btn-danger {
      background-color: #8B0000;
      border-color: #8B0000;
    }
    .btn-danger:hover {
      background-color: #6B0000;
      border-color: #6B0000;
    }
    select {
      max-width: 300px;
    }

    .details {
      margin-bottom: 1rem;
      padding: 5px;
    }

    .card {
      margin-bottom: 1rem;
      border-radius: 98px;
      text-align: center;
    }

    .buttonsE {
      text-align: center;
      justify-content: center;
    }
    .ReassignR {
      display: flex;               
      flex-direction: column;      
      align-items: center;         
      justify-content: center;     
      text-align: center;
    }

  </style>
</head>
<body>
<div class="container ">
  <h1 class="details">Patient Details</h1>

  <% 
    const ISOLATION_CONDITIONS = ['COVID-19', 'Tuberculosis', 'Ebola', 'MERS'];
    const needsIsolation = patient.medicalConditions.some(cond => ISOLATION_CONDITIONS.includes(cond));
  %>

  <% if (needsIsolation) { %>
    <div class="alert alert-warning">
      <strong>Note:</strong> This patient requires an <strong>isolation room</strong> due to their medical condition(s).
    </div>
  <% } %>

  <div class="card">
    <div class="card-body">
      <p class="card-text"><strong>ID:</strong> <%= patient._id %></p>
      <p class="card-text"><strong>Name:</strong> <%= patient.name %></p>
      <p class="card-text"><strong>Age:</strong> <%= patient.age %></p>
      <p class="card-text"><strong>Gender:</strong> <%= patient.gender.charAt(0).toUpperCase() + patient.gender.slice(1) %></p>
      <p class="card-text"><strong>Admission Date:</strong> <%= patient.admissionDate.toDateString() %></p>
      <p class="card-text"><strong>Allergies:</strong> 
        <% if (patient.allergies.length > 0) { %>
          <%= patient.allergies.join(", ") %>
        <% } else { %>
          None
        <% } %>
      </p>
      <p class="card-text"><strong>Medical Conditions:</strong> 
        <% if (patient.medicalConditions.length > 0) { %>
          <%= patient.medicalConditions.join(", ") %>
        <% } else { %>
          None
        <% } %>
      </p>
      <p class="card-text">
        <strong>Room:</strong>
        <% if (room) { %>
          Room <%= room.number %>
          <% if (room.type === 'isolation') { %>
            <span class="badge bg-danger">Isolation</span>
          <% } else { %>
            <span class="badge bg-secondary">General</span>
          <% } %>
        <% } else { %>
          Not assigned
        <% } %>
      </p>
    </div>
  </div>

  <% if (session.role === 'admin') { %>
  <div class="buttonsE">
    <a href="/patient/<%= patient._id %>/edit" class="btn btn-primary me-2">Edit</a>
    <form action="/patient/<%= patient._id %>?_method=DELETE" method="POST" class="d-inline">
      <button type="submit" class="btn btn-danger">Delete</button>
    </form>
  </div>
  

  <hr />

<div class="ReassignR">
  <h3>Reassign Room</h3>
  <form action="/patient/<%= patient._id %>/assign-room" method="POST" class="w-100" style="max-width: 400px;">
    <select name="roomId" required class="form-select mb-3">
      <option value="" disabled <%= !room ? 'selected' : '' %>>Select a room</option>
      <% rooms.forEach(r => { 
           const isRoomFull = r.occupants.length >= r.capacity;
           const isMatch = needsIsolation ? r.type === 'isolation' : true;
           if ((isMatch && !isRoomFull) || (room && r._id.toString() === room._id.toString())) { %>
        <option value="<%= r._id %>" <%= room && r._id.toString() === room._id.toString() ? 'selected' : '' %>>
          Room <%= r.number %> (<%= r.type.charAt(0).toUpperCase() + r.type.slice(1) %>) - Occupied: <%= r.occupants.length %> / <%= r.capacity %>
        </option>
      <% } }) %>
    </select>
    <button type="submit" class="btn btn-primary mt-2 w-100">Assign Room</button>
  </form>
  <% } %>

  <a href="/patients" class="btn btn-secondary mt-4">Back to List</a>
</div>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
</body>
</html>
