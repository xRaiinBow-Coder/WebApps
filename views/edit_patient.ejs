<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Edit Patient</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    :root {
      --forest-green: #2F4F4F;
      --forest-green-light: #3D6B6B;
      --forest-green-dark: #223838;
    }
    body {
      background-color: #F5F6F0;
      color: var(--forest-green-dark);
    }
    h1 {
      color: var(--forest-green-dark);
    }
    .btn-primary {
      background-color: var(--forest-green);
      border-color: var(--forest-green);
    }
    .btn-primary:hover {
      background-color: var(--forest-green-dark);
      border-color: var(--forest-green-dark);
    }
    .btn-secondary {
      background-color: var(--forest-green-light);
      border-color: var(--forest-green-light);
    }
    .btn-secondary:hover {
      background-color: var(--forest-green);
      border-color: var(--forest-green);
    }
    .form-control:focus {
      border-color: var(--forest-green);
      box-shadow: 0 0 0 0.25rem rgba(47, 79, 79, 0.25);
    }
    .form-label {
      color: var(--forest-green-dark);
    }
    .invalid-feedback {
      color: #dc3545;
    }
  </style>
</head>
<body>
  <div class="container mt-5">
    <h1 class="mb-4">Edit Patient</h1>
    <form action="/patient/<%= patient._id %>?_method=PUT" method="POST" class="needs-validation" novalidate>
      <!-- Full Name -->
      <div class="mb-3">
        <label for="name" class="form-label">Full Name</label>
        <input type="text" class="form-control" id="name" name="name" value="<%= patient.name %>" required>
        <div class="invalid-feedback">Please enter a name.</div>
      </div>

      <!-- Age -->
      <div class="mb-3">
        <label for="age" class="form-label">Age</label>
        <input type="number" class="form-control" id="age" name="age" value="<%= patient.age %>" required>
        <div class="invalid-feedback">Please enter a valid age.</div>
      </div>

      <!-- Gender -->
      <div class="mb-3">
        <label for="gender" class="form-label">Gender</label>
        <select class="form-select" id="gender" name="gender" required>
          <option value="">Select gender</option>
          <option value="male" <%= patient.gender === 'male' ? 'selected' : '' %>>Male</option>
          <option value="female" <%= patient.gender === 'female' ? 'selected' : '' %>>Female</option>
          <option value="other" <%= patient.gender === 'other' ? 'selected' : '' %>>Other</option>
        </select>
        <div class="invalid-feedback">Please select a gender.</div>
      </div>

      <!-- Allergies -->
      <div class="mb-3">
        <label for="allergies" class="form-label">Allergies (comma-separated)</label>
        <input type="text" class="form-control" id="allergies" name="allergies" value="<%= patient.allergies.join(', ') %>">
        <div class="form-text">Separate multiple allergies with commas.</div>
      </div>

      <!-- Medical Conditions -->
      <div class="mb-3">
        <label for="medicalConditions" class="form-label">Medical Conditions (comma-separated)</label>
        <input
          type="text"
          class="form-control"
          id="medicalConditions"
          name="medicalConditions"
          value="<%= patient.medicalConditions.join(', ') %>"
          <%= isAdmin ? '' : 'readonly' %>
          <%= isAdmin ? '' : 'tabindex="-1"' %>
        >
        <div class="form-text">
          Separate multiple conditions with commas.<br>
          <% if (!isAdmin) { %>
            (Editing medical conditions is restricted to admins)
          <% } %>
        </div>
      </div>

      <!-- Admin-only: Isolation Status -->
      <% if (isAdmin) { %>
        <div class="mb-3">
          <label class="form-label">Isolation Status</label>
          <div class="form-check">
            <input class="form-check-input" type="checkbox" id="covid" name="isolationStatus" value="covid" <%= patient.isolationStatus?.includes('covid') ? 'checked' : '' %> >
            <label class="form-check-label" for="covid">COVID-19</label>
          </div>
          <div class="form-check">
            <input class="form-check-input" type="checkbox" id="tuberculosis" name="isolationStatus" value="tuberculosis" <%= patient.isolationStatus?.includes('tuberculosis') ? 'checked' : '' %> >
            <label class="form-check-label" for="tuberculosis">Tuberculosis</label>
          </div>
          <div class="form-check">
            <input class="form-check-input" type="checkbox" id="ebola" name="isolationStatus" value="ebola" <%= patient.isolationStatus?.includes('ebola') ? 'checked' : '' %> >
            <label class="form-check-label" for="ebola">Ebola</label>
          </div>
          <div class="form-check">
            <input class="form-check-input" type="checkbox" id="none" name="isolationStatus" value="none" <%= (!patient.isolationStatus || patient.isolationStatus.length === 0) ? 'checked' : '' %> >
            <label class="form-check-label" for="none">None</label>
          </div>
          <div class="form-text">Select all that apply. Select "None" if no isolation required.</div>
        </div>

        <!-- Room assignment -->
        <div class="mb-3">
          <label for="roomId" class="form-label">Assign Room</label>
          <select class="form-select" id="roomId" name="roomId" required>
            <option value="">Select room</option>
            <% rooms.forEach(room => { 
              const availableSpots = room.capacity - room.occupants.length;
              if (availableSpots > 0) { %>
              <option value="<%= room._id %>" <%= patient.roomId && patient.roomId.toString() === room._id.toString() ? 'selected' : '' %>>
                Room <%= room.number %> — <%= availableSpots %> spot(s) <% if (room.type === 'isolation') { %> [Isolation] <% } %>
              </option>
            <% } }); %>
          </select>
          <div class="invalid-feedback">Please select a room with available capacity.</div>
        </div>
      <% } %>

      <button type="submit" class="btn btn-primary">Update</button>
      <a href="/patients" class="btn btn-secondary ms-2">Back to List</a>
    </form>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    (function () {
      'use strict'
      var forms = document.querySelectorAll('.needs-validation')
      Array.prototype.slice.call(forms)
        .forEach(function (form) {
          form.addEventListener('submit', function (event) {
            if (!form.checkValidity()) {
              event.preventDefault()
              event.stopPropagation()
            }
            form.classList.add('was-validated')
          }, false)
        })
    })()
  </script>
</body>
</html>
