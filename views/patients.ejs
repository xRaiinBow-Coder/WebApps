<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Patient List</title>
    <!-- Bootstrap CSS CDN -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <style>
        /* Forest green theme */
        :root {
            --forest-green: #2F4F4F;
            --forest-green-light: #3D6B6B;
            --forest-green-dark: #223838;
        }
        body {
            background-color: #F5F6F0;
            color: var(--forest-green-dark);
        }
        h1 {
            color: var(--forest-green-dark);
        }
        .btn-primary {
            background-color: var(--forest-green);
            border-color: var(--forest-green);
        }
        .btn-primary:hover {
            background-color: var(--forest-green-dark);
            border-color: var(--forest-green-dark);
        }
        .list-group-item {
            background-color: #FFFFFF;
            border-color: var(--forest-green-light);
            color: var(--forest-green-dark);
        }
        .list-group-item:hover {
            background-color: #F5F6F0;
        }
        a.text-decoration-none {
            color: var(--forest-green);
        }
        a.text-decoration-none:hover {
            color: var(--forest-green-dark);
        }
    </style>
</head>
<body>
<div class="container mt-5">
    <h1 class="mb-4">Patient List</h1>
    
    <!-- Navigation Buttons -->
    <div class="mb-3">
        <a href="/patient/new" class="btn btn-primary me-2">Add a New Patient</a>
        <a href="/rooms" class="btn btn-outline-primary">View Rooms</a>
    </div>

    <ul class="list-group mb-4">
        <% patients.forEach(patient => { %>
            <li class="list-group-item">
                <a href="/patient/<%= patient._id %>" class="text-decoration-none">
                    <strong><%= patient.name %></strong> - Age: <%= patient.age %>, Gender: <%= patient.gender.charAt(0).toUpperCase() + patient.gender.slice(1) %>
                </a>
            </li>
        <% }) %>
    </ul>
</div>

<!-- Bootstrap JS Bundle (optional) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
</body>
</html>

